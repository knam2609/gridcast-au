# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=gridcast
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gridcast
POSTGRES_PORT=5433

# Used by the Python app (alembic, ETL, backtests). Host port matches POSTGRES_PORT.
GRIDCAST_DATABASE_URL=postgresql+psycopg://gridcast:change-me@localhost:5433/gridcast
# Separate database used by integration tests (created automatically by the test fixture).
GRIDCAST_TEST_DATABASE_URL=postgresql+psycopg://gridcast:change-me@localhost:5433/gridcast_test

GRIDCAST_CONFIG=configs/base.yaml
# Optional: where raw downloads, interim parquet and backtest predictions live
# (default ./data). Useful for an external drive; must exist (mount the drive first).
# GRIDCAST_DATA_ROOT=/Volumes/MyDrive/gridcast-au/data
GRIDCAST_LOG_LEVEL=INFO
# "console" for humans, "json" for machines / containers
GRIDCAST_LOG_FORMAT=console
